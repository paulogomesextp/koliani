[gd_scene load_steps=7 format=3 uid="uid://bkolianikameha01"]

; Kamehameha ROXO da Koliani (habilidade "projetil"). Rajada esticada tipo
; feixe que ATRAVESSA inimigos e so se parte contra o cenario ou ao fim do
; tempo. collision_mask = 5 -> "mundo" (1) + "inimigos" (4);
; collision_layer = 0 (nao e solido, so deteta). Custo/energia em koliani.gd.
; Cabeca = FLARE ROXO espetado, 8 frames (pack "500 Bullet 24x24 Free",
; bloco roxo -> assets/sprites/pixel/fx/flare_roxo.png, recortado por
; tools/gerar_fx_portal_balas.py) a puxar o feixe. Voltou ao roxo em 4 set
; 2026, com o rig "Shadowblade"; o feixe acompanha a cor da cabeca.

