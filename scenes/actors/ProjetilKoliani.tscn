[gd_scene load_steps=7 format=3 uid="uid://bkolianiprojkoliani01"]

; Projétil mágico da Koliani (habilidade "projetil"). Bate igual à espada e
; parte-se contra inimigos ou cenário. collision_mask = 5 -> "mundo" (1) +
; "inimigos" (4); collision_layer = 0 (não é sólido, só deteta).
; Corpo = LASER ROXO do pack Wenrexa "Laser2020" (CC0), recortado por
; tools/gerar_fx_laser.py -> assets/sprites/pixel/fx/laser_roxo.png. E' um
; glow de alta resolucao, por isso o Corpo desenha-se com texture_filter = 2
; (LINEAR): a Nearest o degrade' sairia aos degraus. Nao tem frames -- o
; "vivo" vem do pulsar da escala, no projetil_koliani.gd.

[ext_resource type="Script" path="res://scripts/projetil_koliani.gd" id="1_proj"]
[ext_resource type="Texture2D" path="res://assets/sprites/pixel/fx/laser_roxo.png" id="2_bala"]

