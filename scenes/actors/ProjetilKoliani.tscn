[gd_scene load_steps=7 format=3 uid="uid://bkolianiprojkoliani01"]

; Projétil mágico da Koliani (habilidade "projetil"). Bate igual à espada e
; parte-se contra inimigos ou cenário. collision_mask = 5 -> "mundo" (1) +
; "inimigos" (4); collision_layer = 0 (não é sólido, só deteta).
; Corpo = orbe AZUL a girar (bdragon1727 "Free Effect and Bullet 16x16",
; folha Water linha 0 col 30-35 -> assets/sprites/pixel/fx/bala_azul.png).
; Azul, e nao roxo, para casar com o manto da Koliani (rig "nova", 3 set
; 2026); o roxo ficou para os projecteis do Zeriko.

