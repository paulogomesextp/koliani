; O fundo do Desfiladeiro e' o MAR DE NUVENS, nao uma poca. A banda
; lisa cor-de-ameixa era "o elemento com mais ar de placeholder" do
; audit -- ~15%% do ecra, sem textura, sem profundidade e sem
; transicao para o que esta' por cima. A `superficie_textura` (que o
; `agua_venenosa.gd` ja' sabia usar desde 9H.12D) recebe a MESMA
; `nuvens.png` do parallax: duas veus a deslizar a velocidades
; diferentes por cima da linha. Mesma colisao, mesmo `dano`.
[node name="FundoDoAbismo" parent="." instance=ExtResource("13_lava")]
position = Vector2(1700, 980)
largura = 3900.0
altura = 340.0
; o fundo do desfiladeiro e' o abismo, nao acido nem lava -- e um
; abismo nao deita BRASAS a subir, que era o ultimo resto da forja
cor = Color(0.46, 0.14, 0.28, 0.9)
brasas = false

