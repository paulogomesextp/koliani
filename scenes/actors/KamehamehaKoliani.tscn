[gd_scene load_steps=8 format=3 uid="uid://bkolianikameha01"]

; Kamehameha ROXO da Koliani (habilidade "projetil"). Rajada esticada tipo
; feixe que ATRAVESSA inimigos e so se parte contra o cenario ou ao fim do
; tempo. collision_mask = 5 -> "mundo" (1) + "inimigos" (4);
; collision_layer = 0 (nao e solido, so deteta). Custo/energia em koliani.gd.
; O FEIXE e' o raio roxo do pack Wenrexa "Laser2020" (CC0), recortado por
; tools/gerar_fx_laser.py -> assets/sprites/pixel/fx/laser_raio_roxo.png.
; Substituiu os tres Polygon2D desenhados a' mao (aura/feixe/nucleo), que
; eram a parte que se lia como "feita por codigo". Glow de alta resolucao,
; por isso texture_filter = 2 (LINEAR). A Cabeca (flare do pack das balas)
; fica so' como remate a puxar a ponta.

