[gd_scene load_steps=7 format=3 uid="uid://bkolianiprojkoliani01"]

; Projétil mágico da Koliani (habilidade "projetil"). Bate igual à espada e
; parte-se contra inimigos ou cenário. collision_mask = 5 -> "mundo" (1) +
; "inimigos" (4); collision_layer = 0 (não é sólido, só deteta).
; Corpo = VORTICE ROXO a girar, 8 frames (pack "500 Bullet 24x24 Free",
; bloco roxo -> assets/sprites/pixel/fx/bala_roxa.png, recortado por
; tools/gerar_fx_portal_balas.py). Voltou ao roxo em 4 set 2026: o rig
; "Shadowblade" da Koliani e' escuro/roxo e o azul deixou de lhe casar.

