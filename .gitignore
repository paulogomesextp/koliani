# Editor do Godot (binarios locais, nao versionar)
/Godot/
/jogar.local.bat

# Import cache
*.import.bak

# Sistema
.DS_Store
Thumbs.db
*.tmp

# Builds locais / templates de export
*.apk
*.aab
*.pck
*.zip
/exports/

# Keystores (nunca commitar chaves de assinatura reais)
*.keystore
*.jks
release.keystore

# Python
__pycache__/
*.pyc
assets/sprites/pixel/_preview_*
assets/sprites/pixel/**/_preview_*
assets/ui/_preview_*

# lixo de zips do macOS
__MACOSX/
.DS_Store

# packs em bruto largados em incoming/ (grandes) -- so' se comita o que se
